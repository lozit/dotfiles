{
  "title": "Super sur Caps Lock",
  "rules": [
    {
      "description": "Caps Lock : maintenu = Super (⌃⌥⌘, Maj reste libre), appui court = Caps Lock",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "caps_lock",
            "modifiers": { "optional": ["any"] }
          },
          "to": [
            {
              "key_code": "left_command",
              "modifiers": ["left_control", "left_option"]
            }
          ],
          "to_if_alone": [
            { "key_code": "caps_lock", "hold_down_milliseconds": 250 }
          ]
        }
      ]
    }
  ]
}
