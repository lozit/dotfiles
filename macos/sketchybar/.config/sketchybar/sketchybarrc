#!/bin/bash
# ─────────────────────────────────────────────────────────────
#  SketchyBar — config minimaliste transparente (Guillaume)
#  Emplacement : ~/.config/sketchybar/sketchybarrc
#  Recharger   : sketchybar --reload
# ─────────────────────────────────────────────────────────────

PLUGIN_DIR="$CONFIG_DIR/plugins"

# Couleurs (format 0xAARRGGBB)
WHITE=0xffe6e6e6
DIM=0x99e6e6e6
ACCENT=0xffffffff
TRANSPARENT=0x00000000

# Polices (brew install --cask font-sf-pro font-sf-mono)
FONT_TEXT="SF Pro"
FONT_MONO="SF Mono"

# ── Barre ────────────────────────────────────────────────────
sketchybar --bar position=top \
  height=32 \
  color=$TRANSPARENT \
  border_width=0 \
  blur_radius=0 \
  shadow=off \
  padding_left=12 \
  padding_right=40 \
  display=main

# ── Valeurs par défaut des items ────────────────────────────
sketchybar --default updates=when_shown \
  icon.font="$FONT_TEXT:Semibold:11.0" \
  icon.color=$DIM \
  label.font="$FONT_MONO:Medium:12.0" \
  label.color=$WHITE \
  label.shadow.drawing=on \
  label.shadow.color=0x80000000 \
  label.shadow.distance=1 \
  icon.shadow.drawing=on \
  icon.shadow.color=0x80000000 \
  icon.shadow.distance=1 \
  icon.padding_left=6 \
  icon.padding_right=4 \
  label.padding_left=0 \
  label.padding_right=6 \
  background.drawing=off

# ── DROITE (ajoutés de droite à gauche) ─────────────────────
sketchybar --add item clock right \
  --set clock update_freq=15 \
  icon.drawing=off \
  label.font="$FONT_TEXT:Semibold:12.0" \
  script="$PLUGIN_DIR/clock.sh"

sketchybar --add item battery right \
  --set battery update_freq=120 \
  icon="BAT" \
  script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change

sketchybar --add item volume right \
  --set volume icon="VOL" \
  script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume volume_change

# Prochain rendez-vous (Calendrier macOS via helpers/next_event)
# Compiler une fois : voir helpers/next_event.swift
sketchybar --add item calendar left \
  --set calendar update_freq=60 \
  icon.drawing=off \
  label.font="$FONT_TEXT:Medium:12.0" \
  click_script="open -a Calendar" \
  script="$PLUGIN_DIR/calendar.sh" \
  --subscribe calendar system_woke

sketchybar --add item network right \
  --set network update_freq=2 \
  icon.drawing=off \
  script="$PLUGIN_DIR/network.sh"

sketchybar --add item ram right \
  --set ram update_freq=5 \
  icon="RAM" \
  script="$PLUGIN_DIR/ram.sh"

sketchybar --add item cpu right \
  --set cpu update_freq=2 \
  icon="CPU" \
  script="$PLUGIN_DIR/cpu.sh"

# ── Lancement ────────────────────────────────────────────────
sketchybar --update
