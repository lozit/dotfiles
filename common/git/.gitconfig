[user]
	name = Guillaume Ferrari
	# Pas d'adresse ici (dépôt public). Git refuse de committer
	# plutôt que d'en deviner une si aucune n'est définie.
	useConfigOnly = true

[core]
	hooksPath = ~/Library/Application Support/ggshield/git-hooks

# Adresse e-mail, propre à chaque machine, NON versionnée :
#   ~/.gitconfig.local  →  [user] email = ...
[include]
	path = ~/.gitconfig.local

# ── delta : diffs lisibles (thème Catppuccin Mocha) ─────────
[include]
	path = ~/.config/git/catppuccin-delta.gitconfig
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	features = catppuccin-mocha
	navigate = true        # n / N pour passer d'un fichier à l'autre
	line-numbers = true
	side-by-side = false
[merge]
	conflictStyle = zdiff3
[diff]
	algorithm = histogram    # diffs plus clairs sur les lignes déplacées
	colorMoved = default
	mnemonicPrefix = true
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[rerere]
	enabled = true
	autoupdate = true

# ── Repris d'Omarchy (config/git/config) ────────────────────
[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
[commit]
	verbose = true           # affiche le diff dans l'éditeur du message
[column]
	ui = auto
[branch]
	sort = -committerdate    # branches les plus récentes en premier
[tag]
	sort = -version:refname
